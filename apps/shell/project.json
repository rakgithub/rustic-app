{
  "name": "shell",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "apps/shell/src",
  "projectType": "application",
  "tags": ["scope:shell", "type:app"],
  "targets": {
    "generate-remotes": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "command": "node ../../tools/scripts/generate-remotes.mjs",
        "cwd": "apps/shell"
      }
    },
    "serve": {
      "executor": "nx:run-commands",
      "continuous": true,
      "options": {
        "command": "vite",
        "cwd": "apps/shell"
      }
    },
    "build": {
      "executor": "nx:run-commands",
      "dependsOn": ["generate-remotes"],
      "options": {
        "command": "vite build",
        "cwd": "apps/shell"
      }
    },
    "federation-smoke": {
      "executor": "nx:run-commands",
      "options": {
        "command": "node tools/scripts/federation-smoke.mjs"
      }
    }
  }
}
