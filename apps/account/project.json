{
  "name": "account",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "apps/account/src",
  "projectType": "application",
  "tags": [
    "scope:account", 
    "type:app"
  ],
  "targets": {
    "serve": {
      "executor": "nx:run-commands",
      "continuous": true,
      "options": {
        "command": "vite",
        "cwd": "apps/account"
      },
      "dependsOn": [
        "shell:serve"
      ]
    },
    "build": {
      "executor": "nx:run-commands",
      "options": {
        "command": "vite build",
        "cwd": "apps/account"
      }
    }
  }
}
