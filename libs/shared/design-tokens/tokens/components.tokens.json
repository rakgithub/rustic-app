{
  "$description": "Component-level styling aliases. Components consume these tokens instead of choosing raw values or theme-specific colours.",
  "button": {
    "primary": {
      "background": {
        "$type": "color",
        "$value": "{color.action.primary.default}"
      },
      "background-hover": {
        "$type": "color",
        "$value": "{color.action.primary.hover}"
      },
      "background-active": {
        "$type": "color",
        "$value": "{color.action.primary.active}"
      },
      "background-disabled": {
        "$type": "color",
        "$value": "{color.action.primary.disabled}"
      },
      "foreground": {
        "$type": "color",
        "$value": "{color.action.primary.foreground}"
      }
    },
    "secondary": {
      "background": {
        "$type": "color",
        "$value": "{color.action.secondary.default}"
      },
      "background-hover": {
        "$type": "color",
        "$value": "{color.action.secondary.hover}"
      },
      "background-active": {
        "$type": "color",
        "$value": "{color.action.secondary.active}"
      },
      "background-disabled": {
        "$type": "color",
        "$value": "{color.action.secondary.disabled}"
      },
      "foreground": {
        "$type": "color",
        "$value": "{color.action.secondary.foreground}"
      }
    },
    "danger": {
      "background": {
        "$type": "color",
        "$value": "{color.action.danger.default}"
      },
      "background-hover": {
        "$type": "color",
        "$value": "{color.action.danger.hover}"
      },
      "background-active": {
        "$type": "color",
        "$value": "{color.action.danger.active}"
      },
      "foreground": {
        "$type": "color",
        "$value": "{color.action.danger.foreground}"
      }
    },
    "radius": {
      "$type": "dimension",
      "$value": "{radius.md}"
    },
    "padding-inline": {
      "$type": "dimension",
      "$value": "{space.4}"
    },
    "padding-block": {
      "$type": "dimension",
      "$value": "{space.2}"
    },
    "focus-ring": {
      "$type": "color",
      "$value": "{color.border.focus}"
    }
  },
  "input": {
    "background": {
      "$type": "color",
      "$value": "{color.surface.default}"
    },
    "foreground": {
      "$type": "color",
      "$value": "{color.text.primary}"
    },
    "placeholder": {
      "$type": "color",
      "$value": "{color.text.muted}"
    },
    "border": {
      "$type": "color",
      "$value": "{color.border.default}"
    },
    "border-focus": {
      "$type": "color",
      "$value": "{color.border.focus}"
    },
    "border-disabled": {
      "$type": "color",
      "$value": "{color.border.disabled}"
    },
    "background-disabled": {
      "$type": "color",
      "$value": "{color.surface.disabled}"
    },
    "radius": {
      "$type": "dimension",
      "$value": "{radius.md}"
    },
    "padding-inline": {
      "$type": "dimension",
      "$value": "{space.3}"
    },
    "padding-block": {
      "$type": "dimension",
      "$value": "{space.2}"
    }
  },
  "card": {
    "background": {
      "$type": "color",
      "$value": "{color.surface.raised}"
    },
    "foreground": {
      "$type": "color",
      "$value": "{color.text.primary}"
    },
    "border": {
      "$type": "color",
      "$value": "{color.border.default}"
    },
    "border-width": {
      "$type": "dimension",
      "$value": "{border.width.default}"
    },
    "radius": {
      "$type": "dimension",
      "$value": "{radius.lg}"
    },
    "padding": {
      "$type": "dimension",
      "$value": "{space.6}"
    },
    "shadow": {
      "$type": "shadow",
      "$value": "{shadow.sm}"
    }
  },
  "dialog": {
    "backdrop": {
      "$type": "color",
      "$value": "{color.overlay.backdrop}"
    },
    "background": {
      "$type": "color",
      "$value": "{color.surface.raised}"
    },
    "foreground": {
      "$type": "color",
      "$value": "{color.text.primary}"
    },
    "border": {
      "$type": "color",
      "$value": "{color.border.default}"
    },
    "radius": {
      "$type": "dimension",
      "$value": "{radius.lg}"
    },
    "padding": {
      "$type": "dimension",
      "$value": "{space.6}"
    },
    "shadow": {
      "$type": "shadow",
      "$value": "{shadow.md}"
    }
  }
}
